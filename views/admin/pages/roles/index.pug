extends ../../layouts/default.pug

block main
    h1.mb-4 #{pageTitle}
    
    .card.mb-3
      .card-header Danh sách nhóm quyền
      .card-body
        .row.mb-3
          .col-10
            // Có thể thêm bộ lọc hoặc tìm kiếm ở đây
            .col-2.text-right
              a.btn.btn-outline-success(
                href=`/${prefixAdmin}/roles/create`
              ) + Thêm mới

        table(
          class="table table-hover table-sm"
          checkbox-multi
        )
          thead
            tr
              th STT
              th Tiêu đề
              th Mô tả ngắn
              th Hành động

          tbody
            if(roles && roles.length > 0)
              each item, index in roles
                tr
                  td #{index + 1}
                  td #{item.title}
                  td !{item.description}
                  td
                    a(
                      class="btn btn-warning btn-sm"
                      href=`${prefixAdmin}/roles/edit/${item.id}`
                    ) Sửa
                    a.btn.btn-sm.btn-secondary(href=`${prefixAdmin}/roles/detail/${item.id}`) Chi tiết
                    button.btn.btn-sm.btn-danger(
                      button-delete
                      data-id=item.id
                    ) Xóa
            else
              tr
                td(colspan="4" class="text-center") Chưa có nhóm quyền nào được tạo.

      form(
        action=""
        method="POST"
        id="form-delete"
        data-path=`${prefixAdmin}/roles/deleteOne`
      )
