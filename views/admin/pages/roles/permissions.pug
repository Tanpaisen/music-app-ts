extends ../../layouts/default.pug
block main
    .m-2
      h1(class="mb-4") #{pageTitle}
      div(class="text-right")
            button(
            type="submit"
            class="btn btn-primary mb-3"
            button-submit
            ) Cập nhật

      table(
        class="table table-hover table-sm"
        table-permissions
      )
        div(data-records=data)
        thead
          tr
            th Tính năng
            each item in data
              th(class="text-center")=item.title
        tbody
          //- Hàng ẩn để chứa ID của Role (Dùng để gửi lên BE)
          tr(data-name="id" class="d-none")
            td
            each item in data
              td(class="text-center")
                  input(type="text" value=item.id)
            

          //- Nhóm: Quản lý chủ đề
          tr
            td(colspan="3")
              b Quản lý chủ đề
          
          tr(data-name="topics_view")
            td Xem
            each item in data
              td(class="text-center")
                input(type="checkbox")
          
          tr(data-name="topics_create")
            td Thêm mới
            each item in data
              td(class="text-center")
                input(type="checkbox")
          
          tr(data-name="topics_edit")
            td Chỉnh sửa
            each item in data
              td(class="text-center")
                input(type="checkbox")

          tr(data-name="topics_delete")
            td Xóa
            each item in data
              td(class="text-center")
                input(type="checkbox")

