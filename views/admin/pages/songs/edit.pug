extends ../../layouts/default.pug

block main
  if(role.permissions.includes('songs_edit')) 
    h1(class="mb-4") #{pageTitle}

    form(
        action=`/${prefixAdmin}/songs/edit/${song.id}?_method=PATCH`
        method="POST"
        enctype="multipart/form-data"
      )
        div(class="form-group")
          label(for="title") Tiêu đề
          input(
            type="text"
            class="form-control"
            id="title"
            name="title"
            value=song.title
            required
          )
        div(class="form-group")
          label(for="topic") Chủ đề
          select(
            name="topicId"
            id="topic"
            class="form-control"
            required
          )
            option(value="" disabled ) -- Chọn chủ đề --
            each item in topics
              option(
                  value=item.id
                  selected=(item.id==song.topicId?true:false)
              ) #{item.title}
        div(class="form-group")
          label(for="singer") Ca sĩ
          select(
            name="singerId"
            id="singer"
            class="form-control"
            required
          )
            option(value="" disabled ) -- Chọn ca sĩ --
            each item in singers
              option(
                  value=item.id
                  selected=(item.id==song.singerId?true:false)
              ) #{item.fullName}
        .form-group
          label(for="albumId") Album (không bắt buộc)
          select#albumId.form-control(name="albumId")
            option(value="" selected=!song.albumId) Không thuộc album
            each album in albums
              option(value=album.id selected=String(song.albumId || '') === album.id)= album.title + (album.status === 'inactive' ? ' (đang ẩn)' : '')
          small.form-text.text-muted Tạo album trong mục Quản lý album trước, sau đó gán bài hát vào album.
        .form-group
          label(for="trackNumber") Số thứ tự bài trong album (1, 2, 3...)
          input#trackNumber.form-control(type="number" name="trackNumber" min="0" max="999" value=song.trackNumber || 0)
        div(
          class="form-group"
          upload-image
        )
          label(for="avatar") Ảnh
          input(
            type="file"
            class="form-control-file"
            id="avatar"
            name="avatar"
            accept="image/*"
            upload-image-input
          )
          img(
            src=song.avatar
            class="image-preview"
            upload-image-preview
          )
        div(class="form-group" upload-audio)
          label(for="audio") File âm thanh
          input(
            type="file"
            class="form-control-file"
            id="audio"
            name="audio"
            accept="audio/*"
            upload-audio-input
          )
          audio(controls upload-audio-play)
            source(src=song.audio)  
        div(class="form-group")
          label(for="desc") Lyric
          textarea(
            type="text"
            class="form-control"
            id="lyrics"
            name="lyrics"
            rows="5"
            textarea-mce
          ) !{song.lyrics}
        div(class="form-group")
          label(for="desc") Mô tả
          textarea(
            type="text"
            class="form-control"
            id="desc"
            name="description"
            rows="5"
            textarea-mce
          ) !{song.description}
        div(class="form-group form-check form-check-inline")
          input(
            type="radio"
            class="form-check-input"
            id="statusActive"
            name="status"
            value="active"
            checked = (song.status=="active"?true:false)
          )
          label(for="statusActive" class="form-check-label") Hoạt động
        div(class="form-group form-check form-check-inline")
          input(
            type="radio"
            class="form-check-input"
            id="statusInActive"
            name="status"
            value="inactive"
            checked = (song.status=="inactive"?true:false)
          )
          label(for="statusInActive" class="form-check-label") Dừng hoạt động
        div(class="form-group")
          button(
            type="submit"
            class="btn btn-primary"
          ) Sửa