header.header
  .container
    .row.align-items-center
      .col-1.header-item
        .inner-logo
          a(href="/")
            img(src="")
      .col-5
        .box-search
          form(
            action="/search/result"
            method="GET"
          )
            div(class="form-group d-flex mb-0")
              input(
                type="text"
                placeholder="Nhập từ khóa..."
                class="form-control"
                name="keyword"
                value=keyword
              )
              button(
                type="submit"
                class="btn btn-primary"
              ) Tìm
           
      .col-4.header-item
        .inner-menu
          ul
            li
              a(href="/") Trang chủ   
            li
              a(href="/topics") Chủ đề  
            li
              a(href="/songs/favorite") Bài hát yêu thích  
            