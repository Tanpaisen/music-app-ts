extends ../../layouts/default.pug
block main
    .m-2
      h1(class="mb-4") #{pageTitle}
      div(class="text-right")
            button(
            type="submit"
            class="btn btn-primary mb-3"
            button-submit
            ) Cập nhật

      table(
        class="table table-hover table-sm"
        table-permissions
      )
        div(data-records=data)
        thead
          tr
            th Tính năng
            each item in data
              th(class="text-center")=item.title
        tbody
          //- Hàng ẩn để chứa ID của Role (Dùng để gửi lên BE)
          tr(data-name="id" class="d-none")
            td
            each item in data
              td(class="text-center")
                  input(type="text" value=item.id)
            

          //- Nhóm: Danh mục sản phẩm
          tr
            td(colspan="3")
              b Danh mục sản phẩm
          
          tr(data-name="products-category_view")
            td Xem
            each item in data
              td(class="text-center")
                input(type="checkbox")
          
          tr(data-name="products-category_create")
            td Thêm mới
            each item in data
              td(class="text-center")
                input(type="checkbox")
          
          tr(data-name="products-category_edit")
            td Chỉnh sửa
            each item in data
              td(class="text-center")
                input(type="checkbox")

          tr(data-name="products-category_delete")
            td Xóa
            each item in data
              td(class="text-center")
                input(type="checkbox")

          //- Nhóm: Danh sách sản phẩm
          tr
            td(colspan="3")
              b Danh sách sản phẩm
          
          tr(data-name="products_view")
            td Xem
            each item in data
              td(class="text-center")
                input(type="checkbox")
          
          tr(data-name="products_create")
            td Thêm mới
            each item in data
              td(class="text-center")
                input(type="checkbox")
          
          tr(data-name="products_edit")
            td Chỉnh sửa
            each item in data
              td(class="text-center")
                input(type="checkbox")

          tr(data-name="products_delete")
            td Xóa
            each item in data
              td(class="text-center")
                input(type="checkbox")

          //- Nhóm: Quản lý nhóm quyền
          tr
            td(colspan="3")
              b Quản lý nhóm quyền
          
          tr(data-name="roles_view")
            td Xem
            each item in data
              td(class="text-center")
                input(type="checkbox")
          
          tr(data-name="roles_create")
            td Thêm mới
            each item in data
              td(class="text-center")
                input(type="checkbox")
          
          tr(data-name="roles_edit")
            td Chỉnh sửa
            each item in data
              td(class="text-center")
                input(type="checkbox")
          
          tr(data-name="roles_delete")
            td Xóa
            each item in data
              td(class="text-center")
                input(type="checkbox")
          //- Nhóm: Quản lý nhóm quyền
          tr
            td(colspan="3")
              b Phân quyền
          
          tr(data-name="roles-permissions_view")
            td Xem
            each item in data
              td(class="text-center")
                input(type="checkbox")
          
          tr(data-name="roles-permissions_edit")
            td Chỉnh sửa
            each item in data
