            each item in data
              td(class="text-center")
                input(type="checkbox")
    
      form(
        id="form-change-permissions"
        method="POST"
        action=`${prefixAdmin}/roles/permissions?_method=PATCH`
      )
        div(class="form-group")
          input(
            type="text"
            class="form-control"
            name="permissions"
            class="d-none"
          )
      script(src="/admin/js/role.js")