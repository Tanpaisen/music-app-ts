            td Thêm mới
            each item in data
              td(class="text-center")
                input(type="checkbox")
          
          tr(data-name="blogs-category_edit")
            td Chỉnh sửa
            each item in data
              td(class="text-center")
                input(type="checkbox")
          
          tr(data-name="blogs-category_delete")
            td Xóa
            each item in data
              td(class="text-center")
                input(type="checkbox")
          //- Nhóm: Bài viết
          tr
            td(colspan="3")
              b Bài viết
          
          tr(data-name="blogs_view")
            td Xem
            each item in data
              td(class="text-center")
