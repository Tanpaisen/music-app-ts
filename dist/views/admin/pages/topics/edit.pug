extends ../../layouts/default.pug

block main
    if(role.permissions.includes('topics_edit')) 
        h1(class="mb-4") #{pageTitle}

        form(
            action=`/${prefixAdmin}/topics/edit/${topic.id}?_method=PATCH`
            id="form-edit-topic"
            method="POST"
            enctype="multipart/form-data"
        )
            div(class="form-group")
                label(for="title") Tiêu đề
                input(
                    type="text"
                    class="form-control"
                    id="title"
                    name="title"
                    value=topic.title
                    required
            )
            div(
                class="form-group"
                upload-image
            )
                label(for="avatar") Ảnh
                input(
                    type="file"
                    class="form-control-file"
                    id="avatar"
                    name="avatar"
                    accept="image/*"
                    upload-image-input
                )
                img(
                    src=topic.avatar
                    class="image-preview"
                    upload-image-preview
                )
            div(class="form-group")
                label(for="desc") Mô tả
                textarea(
                    type="text"
                    class="form-control"
                    id="desc"
                    name="description"
                    rows="5"
                    textarea-mce
                ) !{topic.description}
            div(class="form-group")
                label(for="categoryKey") Danh mục hiển thị
                select(class="form-control" id="categoryKey" name="categoryKey" required)
                    each category in topicCategories
                        option(value=category.key selected=(topic.categoryKey || "khac") === category.key)= category.label
            div(class="form-group")
                label(for="sortOrder") Thứ tự hiển thị (số nhỏ đứng trước)
                input(type="number" min="0" max="9999" class="form-control" name="sortOrder" id="sortOrder" value=(topic.sortOrder || 0))
            div(class="form-group form-check")
                input(type="checkbox" class="form-check-input" name="featured" id="featured" checked=Boolean(topic.featured))
                label(class="form-check-label" for="featured") Hiển thị ở mục Nổi bật
            div(class="form-group form-check form-check-inline")
                input(
                    type="radio"
                    class="form-check-input"
                    id="statusActive"
                    name="status"
                    value="active"
                    checked=(topic.status=="active"?true:false)
                )
                label(for="statusActive" class="form-check-label") Hoạt động
            div(class="form-group form-check form-check-inline")
                input(
                    type="radio"
                    class="form-check-input"
                    id="statusInActive"
                    name="status"
                    value="inactive"
                    checked=(topic.status=="inactive"?true:false)
                )
                label(for="statusInActive" class="form-check-label") Dừng hoạt động
            div(class="form-group")
                button(
                    type="submit"
                    class="btn btn-primary"
                ) Sửa